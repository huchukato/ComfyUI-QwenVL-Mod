# ComfyUI-QwenVL-Mod RunPod Worker (CUDA 12.8)
# Based on runpod/comfyui:cuda12.8 template (includes ComfyUI core, Manager legacy UI,
# KJNodes, Civicomfy, RunpodDirect, FileBrowser, Jupyter, SSH, persistence on /workspace)
# Adds: custom nodes, llama-cpp-python, sageattention, TensorRT, essential models, WAN2.2 workflows
# Compatible with RTX 4090 (Ada) and RTX 5090 (Blackwell)

FROM runpod/comfyui:cuda12.8

# ──────────────────────────────────────────────────────────────────────────────
# Custom nodes (excludes 4 already baked: Manager, KJNodes, Civicomfy, RunpodDirect)
# ──────────────────────────────────────────────────────────────────────────────
RUN cd /opt/comfyui-baked/custom_nodes && \
    git clone https://github.com/huchukato/comfy-tagcomplete.git && \
    git clone https://github.com/huchukato/ComfyUI-QwenVL-Mod.git && \
    git clone https://github.com/BobRandomNumber/ComfyUI-Crystools-MonitorOnly.git && \
    git clone https://github.com/huchukato/ComfyUI-RIFE-TensorRT-Auto.git && \
    git clone https://github.com/huchukato/ComfyUI-Upscaler-TensorRT-Auto.git && \
    git clone https://github.com/huchukato/ComfyUI-HuggingFace.git && \
    git clone https://github.com/city96/ComfyUI-GGUF.git && \
    git clone https://github.com/Koishi-Star/Euler-Smea-Dyn-Sampler.git && \
    git clone https://github.com/ltdrdata/was-node-suite-comfyui.git && \
    git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && \
    git clone https://github.com/rgthree/rgthree-comfy.git && \
    git clone https://github.com/yolain/ComfyUI-Easy-Use.git && \
    git clone https://github.com/Fannovel16/ComfyUI-Frame-Interpolation.git && \
    git clone https://github.com/Smirnov75/ComfyUI-mxToolkit.git && \
    git clone https://github.com/princepainter/ComfyUI-PainterI2V.git && \
    git clone https://github.com/princepainter/ComfyUI-PainterLongVideo.git && \
    git clone https://github.com/ashtar1984/comfyui-find-perfect-resolution.git && \
    git clone https://github.com/huchukato/ComfyUI-Selectors.git && \
    git clone https://github.com/kijai/ComfyUI-MMAudio.git && \
    git clone https://github.com/GACLove/ComfyUI-VFI.git && \
    git clone https://github.com/stduhpf/ComfyUI-WanMoeKSampler.git && \
    git clone https://github.com/melMass/comfy_mtb.git

# ──────────────────────────────────────────────────────────────────────────────
# Install requirements for all custom nodes
# (system pip → /usr/local/lib/python3.12, available in venv via --system-site-packages)
# ──────────────────────────────────────────────────────────────────────────────
RUN bash -c 'cd /opt/comfyui-baked/custom_nodes && for node_dir in */; do \
        if [ -f "$node_dir/requirements.txt" ]; then \
            echo "Installing requirements for $node_dir..." && \
            pip install --no-cache-dir -r "$node_dir/requirements.txt" || echo "Failed to install requirements for $node_dir"; \
        fi; \
    done' && \
    pip install --no-cache-dir -U "huggingface_hub" "hf-transfer" && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# llama-cpp-python (CUDA 12.8 wheel for GGUF support)
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --upgrade --force-reinstall --no-cache-dir \
    https://github.com/JamePeng/llama-cpp-python/releases/download/v0.3.45-cu128-linux-20260801/llama_cpp_python-0.3.45%2Bcu128-cp312-cp312-linux_x86_64.whl && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# sageattention (required by --use-sage-attention)
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir sageattention && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# TensorRT CUDA 12 wheels (pre-baked to avoid slow install.py at boot)
# Used by ComfyUI-RIFE-TensorRT-Auto and ComfyUI-Upscaler-TensorRT-Auto.
# Base deps (einops, colored, polygraphy, cuda-python, requests, tqdm) are already
# installed by the requirements.txt loop above; only the CUDA-12-specific TRT
# packages are added here so the nodes' install.py becomes a no-op at boot.
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
        tensorrt-cu12==10.13.3.9 \
        tensorrt-cu12-bindings==10.13.3.9 \
        tensorrt-cu12-libs==10.13.3.9 && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# Model directories
# ──────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /opt/comfyui-baked/models/vae && \
    mkdir -p /opt/comfyui-baked/models/upscale_models && \
    mkdir -p /opt/comfyui-baked/models/text_encoders && \
    mkdir -p /opt/comfyui-baked/models/diffusion_models

# ──────────────────────────────────────────────────────────────────────────────
# Pre-baked essential models (~5GB, copied to /workspace on first boot by start.sh)
# ──────────────────────────────────────────────────────────────────────────────
RUN wget -q "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/vae/wan_2.1_vae.safetensors" \
        -O /opt/comfyui-baked/models/vae/wan_2.1_vae.safetensors && \
    wget -q "https://huggingface.co/huchukato/favs/resolve/main/VAE/sdxl.vae.safetensors" \
        -O /opt/comfyui-baked/models/vae/sdxl_vae.safetensors && \
    wget -q "https://huggingface.co/huchukato/favs/resolve/main/ESRGAN/2xLexicaRRDBNet.pth" \
        -O /opt/comfyui-baked/models/upscale_models/2xLexicaRRDBNet.pth && \
    wget -q "https://huggingface.co/huchukato/favs/resolve/main/ESRGAN/2xLexicaRRDBNet_Sharp.pth" \
        -O /opt/comfyui-baked/models/upscale_models/2xLexicaRRDBNet_Sharp.pth && \
    wget -q "https://huggingface.co/NSFW-API/NSFW-Wan-UMT5-XXL/resolve/main/nsfw_wan_umt5-xxl_fp8_scaled.safetensors" \
        -O /opt/comfyui-baked/models/text_encoders/nsfw_wan_umt5-xxl_fp8_scaled.safetensors

# ──────────────────────────────────────────────────────────────────────────────
# Pre-baked WAN 2.2 workflows
# ──────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /opt/comfyui-baked/user/default/workflows && \
    cd /opt/comfyui-baked/user/default/workflows && \
    for url in \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/PMP-LoRaStack-Upscale-Wildcards.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-AutoPrompt-Story.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-T2V-I2V-AutoPrompt-Story.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-SVI-AutoPrompt-Story.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-AutoPrompt.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-AutoPrompt-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-T2V-AutoPrompt.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-T2V-AutoPrompt-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-SVI-AutoPrompt.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-SVI-AutoPrompt-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-Full-AutoPrompt-MMAudio.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-I2V-Full-AutoPrompt-MMAudio-GGUF.json" \
        "https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows/WAN2.2-T2V-I2V-Full-AutoPrompt-MMAudio-GGUF.json"; do \
        name=$(basename "$url"); \
        echo "Downloading $name..."; \
        for attempt in 1 2 3; do \
            curl -fsSL --retry 3 --connect-timeout 30 "$url" -o "$name" && break; \
            echo "⚠️  $name download failed (attempt $attempt), retrying..."; \
            sleep 5; \
        done; \
        [ -s "$name" ] || { echo "❌ Failed to download $name"; exit 1; }; \
    done

# ──────────────────────────────────────────────────────────────────────────────
# Enable Rust-based Hugging Face downloader (hf-transfer) for model downloads
# This is much faster than aria2/wget single-connection on HF-hosted files.
# ──────────────────────────────────────────────────────────────────────────────
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# ──────────────────────────────────────────────────────────────────────────────
# WAN models download script (~30GB, downloaded at boot in background)
# Waits for /workspace/runpod-slim/ComfyUI to exist, then downloads if missing.
# Robust: retries with backoff, resumes interrupted downloads, verifies size.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/download-wan-models.sh << 'EOF'
#!/bin/bash
MODELS_DIR="/workspace/runpod-slim/ComfyUI/models/diffusion_models"
LOG="/var/log/wan-models.log"
READY_MARKER="/workspace/runpod-slim/ComfyUI/main.py"   # created by start.sh copy

# Models: name|repo_id|repo_path|min_size_bytes (min_size = sanity check, ~98% of real 14.29GB)
MODELS=(
    "wan22RemixT2VI2V_i2vHighV30.safetensors|huchukato/pimp-my-wan|FP8/wan22RemixT2VI2V_i2vHighV30.safetensors|14000000000"
    "wan22RemixT2VI2V_i2vLowV30.safetensors|huchukato/pimp-my-wan|FP8/wan22RemixT2VI2V_i2vLowV30.safetensors|14000000000"
)

log() { echo "$(date): $*" | tee -a "$LOG"; }

log "📥 === WAN models download started (PID $$) ==="

# ── Phase 1: wait for /workspace to be mounted and start.sh to finish copying ──
log "⏳ Waiting for /workspace mount and ComfyUI ready marker..."
for i in $(seq 1 120); do
    [ -f "$READY_MARKER" ] && break
    sleep 5
done

if [ ! -f "$READY_MARKER" ]; then
    log "❌ ERROR: ComfyUI ready marker not found after 600s, aborting"
    exit 1
fi

log "✅ ComfyUI ready, models dir: $MODELS_DIR"
mkdir -p "$MODELS_DIR"

# ── Phase 2: download each model with retry + resume + size check ──
download_model() {
    local name="$1" repo_id="$2" repo_path="$3" min_size="$4"
    local dest="$MODELS_DIR/$name"
    local max_retries=5

    # Use 'hf' command (newer huggingface_hub) or fall back to 'huggingface-cli'
    local hf_cmd="hf"
    command -v hf >/dev/null 2>&1 || hf_cmd="huggingface-cli"

    for attempt in $(seq 1 $max_retries); do
        # Check if already complete (size >= min_size)
        if [ -f "$dest" ]; then
            local size
            size=$(stat -c%s "$dest" 2>/dev/null || stat -f%z "$dest" 2>/dev/null || echo 0)
            if [ "$size" -ge "$min_size" ]; then
                log "✅ $name already present ($size bytes >= $min_size), skipping"
                return 0
            else
                log "⚠️  $name incomplete ($size bytes < $min_size), resuming (attempt $attempt/$max_retries)"
            fi
        else
            log "📥 Downloading $name (attempt $attempt/$max_retries)..."
        fi

        # Download to a temp dir to avoid path nesting issues.
        local tmp_dir="$MODELS_DIR/.tmp_${name//\//_}"
        rm -rf "$tmp_dir"
        mkdir -p "$tmp_dir" "$(dirname "$dest")"
        export HF_HUB_ENABLE_HF_TRANSFER=1
        export HF_XET_HIGH_PERFORMANCE=1
        if $hf_cmd download "$repo_id" "$repo_path" \
                --local-dir "$tmp_dir" \
                --resume-download 2>&1 | tee -a "$LOG"; then
            local downloaded_path="$tmp_dir/$repo_path"
            if [ -f "$downloaded_path" ] || [ -L "$downloaded_path" ]; then
                if [ -L "$downloaded_path" ]; then
                    ln -sf "$(readlink -f "$downloaded_path")" "$dest"
                else
                    mv -f "$downloaded_path" "$dest"
                fi
                rm -rf "$tmp_dir"
                local size
                size=$(stat -L -c%s "$dest" 2>/dev/null || stat -L -f%z "$dest" 2>/dev/null || echo 0)
                if [ "$size" -ge "$min_size" ]; then
                    log "✅ $name downloaded successfully ($size bytes)"
                    return 0
                else
                    log "⚠️  $name downloaded but size $size < $min_size, will retry"
                fi
            else
                log "⚠️  $name not found at $downloaded_path after download, will retry"
                rm -rf "$tmp_dir"
            fi
        else
            log "⚠️  $hf_cmd failed for $name (attempt $attempt), retrying in $((attempt*10))s..."
            rm -rf "$tmp_dir"
        fi

        # Backoff before retry (skip on last attempt)
        [ "$attempt" -lt "$max_retries" ] && sleep $((attempt * 10))
    done

    log "❌ FAILED: $name could not be downloaded after $max_retries attempts"
    return 1
}

failures=0
for entry in "${MODELS[@]}"; do
    IFS='|' read -r name repo_id repo_path min_size <<< "$entry"
    download_model "$name" "$repo_id" "$repo_path" "$min_size" || failures=$((failures + 1))
done

log "📦 === WAN models download finished ($failures failures) ==="
EOF
RUN chmod +x /usr/local/bin/download-wan-models.sh

# ──────────────────────────────────────────────────────────────────────────────
# Boot updates script: ComfyUI core git pull + workflow refresh from GitHub.
# Runs fully in background (launched via setsid in custom-entrypoint.sh) so
# network hiccups NEVER delay/block ComfyUI startup. Bounded timeouts/retries
# everywhere as defense in depth.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/boot-updates.sh << 'EOF'
#!/bin/bash
COMFY_LOG="/var/log/comfyui-update.log"
WF_LOG="/var/log/workflow-update.log"
TARGET_TAG="v0.31.0"

clog() { echo "$(date): $*" | tee -a "$COMFY_LOG"; }
wlog() { echo "$(date): $*" | tee -a "$WF_LOG"; }

# ──────────────────────────────────────────────────────────────────────────────
# Force ComfyUI core to the required tag (baked + active install)
# Skips if already on the tag, otherwise resets/cleans and checks out the tag.
# Re-installs requirements when the version changes.
# ──────────────────────────────────────────────────────────────────────────────
force_comfyui_version() {
    local repo_dir="$1"
    local label="$2"
    if [ ! -d "$repo_dir/.git" ]; then
        clog "⚠️  $label no .git, skipping"
        return 0
    fi

    local current_tag
    current_tag=$(git -C "$repo_dir" describe --tags --exact-match HEAD 2>/dev/null || echo "")
    if [ "$current_tag" = "$TARGET_TAG" ]; then
        clog "✅ $label already on $TARGET_TAG"
        return 0
    fi

    clog "🔧 Ensuring $label is on $TARGET_TAG (current: ${current_tag:-unknown})..."
    git -C "$repo_dir" reset --hard 2>>"$COMFY_LOG" || true
    git -C "$repo_dir" clean -fd 2>>"$COMFY_LOG" || true

    if timeout 60 git -C "$repo_dir" fetch --tags origin 2>>"$COMFY_LOG"; then
        local current_hash target_hash
        current_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        if timeout 30 git -C "$repo_dir" -c advice.detachedHead=false checkout -f "$TARGET_TAG" 2>>"$COMFY_LOG"; then
            target_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            clog "✅ $label forced to $TARGET_TAG ($current_hash -> $target_hash)"
            if [ -f "$repo_dir/requirements.txt" ]; then
                clog "🔄 Re-installing $label requirements..."
                pip install --no-cache-dir -r "$repo_dir/requirements.txt" 2>>"$COMFY_LOG" | tail -n 10 || true
            fi
        else
            clog "❌ $label checkout $TARGET_TAG failed"
        fi
    else
        clog "⚠️  $label fetch tags failed/timed out (offline?), leaving at current version"
    fi
}

# ──────────────────────────────────────────────────────────────────────────────
# Update all custom nodes in a directory (git pull --ff-only, then hard reset)
# Re-installs requirements when a node is updated.
# ──────────────────────────────────────────────────────────────────────────────
update_custom_nodes() {
    local nodes_dir="$1"
    [ ! -d "$nodes_dir" ] && return 0
    clog "🔄 Updating custom nodes in $nodes_dir..."
    for node_dir in "$nodes_dir"/*; do
        [ ! -d "$node_dir/.git" ] && continue
        local name branch
        name=$(basename "$node_dir")
        branch=$(git -C "$node_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        clog "⏳ Updating $name (branch $branch)..."
        if timeout 60 git -C "$node_dir" pull --ff-only origin "$branch" 2>>"$COMFY_LOG"; then
            clog "✅ $name updated"
        else
            clog "⚠️  $name pull failed, attempting hard reset to origin/$branch"
            if timeout 60 git -C "$node_dir" fetch origin "$branch" 2>>"$COMFY_LOG" && \
               timeout 30 git -C "$node_dir" reset --hard "origin/$branch" 2>>"$COMFY_LOG"; then
                clog "✅ $name reset to origin/$branch"
            else
                clog "⚠️  $name update failed, leaving as-is"
            fi
        fi
        if [ -f "$node_dir/requirements.txt" ]; then
            clog "🔄 Installing requirements for $name..."
            pip install --no-cache-dir -r "$node_dir/requirements.txt" 2>>"$COMFY_LOG" | tail -n 5 || true
        fi
    done
}

# ──────────────────────────────────────────────────────────────────────────────
# Check & update workflows from GitHub (small JSON files, no need to rebuild image)
# - Baked baseline: /opt/comfyui-baked/user/default/workflows/ (read-only reference)
# - If user hasn't modified a workflow (matches baked) → update from GitHub
# - If user modified it (differs from baked) → skip, preserve user changes
# --tries=2 caps each wget's worst case instead of the wget default of 20 retries.
# ──────────────────────────────────────────────────────────────────────────────
WORKFLOWS=(
    "PMP-LoRaStack-Upscale-Wildcards.json"
    "WAN2.2-I2V-AutoPrompt-Story.json"
    "WAN2.2-T2V-I2V-AutoPrompt-Story.json"
    "WAN2.2-I2V-SVI-AutoPrompt-Story.json"
    "WAN2.2-I2V-AutoPrompt.json"
    "WAN2.2-I2V-AutoPrompt-GGUF.json"
    "WAN2.2-T2V-AutoPrompt.json"
    "WAN2.2-T2V-AutoPrompt-GGUF.json"
    "WAN2.2-I2V-SVI-AutoPrompt.json"
    "WAN2.2-I2V-SVI-AutoPrompt-GGUF.json"
    "WAN2.2-I2V-Full-AutoPrompt-MMAudio.json"
    "WAN2.2-I2V-Full-AutoPrompt-MMAudio-GGUF.json"
    "WAN2.2-T2V-I2V-Full-AutoPrompt-MMAudio-GGUF.json"
)
WF_BASE_URL="https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows"
WF_BAKED="/opt/comfyui-baked/user/default/workflows"
WF_ACTIVE="/workspace/runpod-slim/ComfyUI/user/default/workflows"
WF_READY="/workspace/runpod-slim/ComfyUI/main.py"

download_workflows() {
    local target_dir="$1"
    local label="$2"
    mkdir -p "$target_dir"

    wlog "🔄 Downloading workflows for $label..."
    local downloaded=0 failed=0

    for wf in "${WORKFLOWS[@]}"; do
        if curl -fsSL --retry 3 --connect-timeout 30 "$WF_BASE_URL/$wf" -o "$target_dir/$wf"; then
            wlog "  ✅ $wf"
            downloaded=$((downloaded + 1))
        else
            wlog "  ❌ $wf failed"
            failed=$((failed + 1))
        fi
    done

    wlog "📋 $label: $ downloaded, $failed failed"
}

wlog "🚀 === Boot updates started (PID $$) ==="

# Update baked template baseline first
download_workflows "$WF_BAKED" "baked"

# Wait for start.sh to finish copying /opt/comfyui-baked -> /workspace/runpod-slim/ComfyUI
# before downloading active workflows; otherwise start.sh may overwrite with old baked copies.
wlog "⏳ Waiting for active ComfyUI install (/workspace) to be ready..."
for i in $(seq 1 120); do
    [ -f "$WF_READY" ] && break
    sleep 5
done

if [ ! -f "$WF_READY" ]; then
    wlog "❌ ERROR: /workspace ComfyUI not ready after 600s, aborting active workflow download"
    exit 1
fi
wlog "✅ /workspace ComfyUI ready"

# Now safe to download active install workflows
download_workflows "$WF_ACTIVE" "active"

# Force baked ComfyUI core to the target tag
force_comfyui_version /opt/comfyui-baked "ComfyUI (baked template)"

# Force active install on /workspace if it already exists (affects restarts)
if [ -d /workspace/runpod-slim/ComfyUI/.git ]; then
    force_comfyui_version /workspace/runpod-slim/ComfyUI "ComfyUI (active install)"
    update_custom_nodes /workspace/runpod-slim/ComfyUI/custom_nodes
fi

clog "🏁 === Boot updates finished ==="
EOF
RUN chmod +x /usr/local/bin/boot-updates.sh

# ──────────────────────────────────────────────────────────────────────────────
# Custom entrypoint: pre-populate comfyui_args.txt, launch boot updates + WAN
# models download fully in background, then exec /start.sh IMMEDIATELY.
# Network calls never block ComfyUI startup.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/custom-entrypoint.sh << 'EOF'
#!/bin/bash

# Pre-populate comfyui_args.txt with WAN2.2 args if it doesn't exist (local, instant)
ARGS_FILE="/workspace/runpod-slim/comfyui_args.txt"
if [ ! -f "$ARGS_FILE" ]; then
    mkdir -p /workspace/runpod-slim
    cat > "$ARGS_FILE" << 'INNER'
# Custom ComfyUI arguments (one per line, # = comment)
--disable-auto-launch
--fast fp16_accumulation
--use-sage-attention
--reserve-vram 2
--cuda-malloc
--async-offload
INNER
    echo "Created comfyui_args.txt with WAN2.2 optimized args"
fi

# Launch boot updates (ComfyUI git pull + workflow refresh) in a detached
# session. setsid creates a new session, so the process is fully independent
# of PID 1 and survives `exec /start.sh` below. Output is NOT redirected to
# /dev/null: each script tees its own log to file AND inherits this
# entrypoint's stdout, so progress shows up in `docker logs` / RunPod logs.
setsid /usr/local/bin/boot-updates.sh </dev/null &

# Launch WAN models download in a detached session (survives exec /start.sh)
setsid /usr/local/bin/download-wan-models.sh </dev/null &

# Execute original start.sh from template base — runs immediately, never
# waits on the network calls above.
exec /start.sh
EOF
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

# ──────────────────────────────────────────────────────────────────────────────
# Clean up heavy Git files to save space (keep repo structure for updates)
# ──────────────────────────────────────────────────────────────────────────────
RUN find /opt/comfyui-baked/custom_nodes -name ".git" -type d -exec find {} -name "*.pack" -delete + 2>/dev/null || true && \
    find /opt/comfyui-baked/custom_nodes -name ".git" -type d -exec find {} -name "pack-*.idx" -delete + 2>/dev/null || true && \
    find /opt/comfyui-baked/custom_nodes -name ".git" -type d -exec find {} -name "objects" -type d -exec rm -rf {} + 2>/dev/null || true

# Override entrypoint (inherits EXPOSE, WORKDIR from template base)
ENTRYPOINT ["/usr/local/bin/custom-entrypoint.sh"]
