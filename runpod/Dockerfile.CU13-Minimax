# ComfyUI-QwenVL-Mod RunPod Worker (CUDA 13.0) — MiniMax H3 edition
# Based on runpod/comfyui:cuda13.0 template (includes ComfyUI core, Manager legacy UI,
# KJNodes, Civicomfy, RunpodDirect, FileBrowser, Jupyter, SSH, persistence on /workspace)
# Adds: QwenVL-Mod + MiniMax H3 support nodes, all heavy MiniMax-H3 models
#       downloaded at boot in background (~50GB total).

FROM runpod/comfyui:cuda13.0

# ──────────────────────────────────────────────────────────────────────────────
# Ensure ComfyUI core is v0.32.0+ (MiniMax H3 requires ComfyUI 0.30.0+)
# The base image may ship an older tag, so we force-checkout the release.
# ──────────────────────────────────────────────────────────────────────────────
RUN cd /opt/comfyui-baked && \
    git fetch --tags --force origin && \
    git -c advice.detachedHead=false checkout -f v0.32.0 && \
    echo "ComfyUI checked out at:" && git rev-parse --short HEAD

# Re-install / verify ComfyUI requirements after the version switch.
# This is best-effort: if it fails, the image still has the base packages.
RUN cd /opt/comfyui-baked && \
    (pip install --no-cache-dir -r requirements.txt || echo "requirements install returned non-zero, continuing") && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# Fix torchvision::nms crash: the base image's /start.sh creates a venv with
# --system-site-packages, which inherits the system torchvision (built for a
# different torch version than the venv ends up with). Keep --system-site-packages
# so other deps (sqlalchemy, alembic, numpy, etc.) remain available from the
# base image, but force-install matching torchvision into the venv to override
# the broken system one.
# ──────────────────────────────────────────────────────────────────────────────
RUN sed -i '/echo "Base packages (torch, numpy, etc.) available from system site-packages"/i\
        pip install --no-cache-dir --force-reinstall --no-deps torchvision==0.25.0+cu130 --index-url https://download.pytorch.org/whl/cu130' /start.sh && \
    echo "Patched /start.sh: torchvision will be force-installed to match venv torch version"

# ──────────────────────────────────────────────────────────────────────────────
# Custom nodes — ALL repos cloned once (cached)
# ──────────────────────────────────────────────────────────────────────────────
# Bump NODES_CACHE_BUSTER to force re-clone of all custom nodes
ARG NODES_CACHE_BUSTER=2026-08-14-v5
RUN cd /opt/comfyui-baked/custom_nodes && \
    git clone https://github.com/BobRandomNumber/ComfyUI-Crystools-MonitorOnly.git && \
    git clone https://github.com/Larryvrh/ComfyUI-MiniMax-H3-Turbo.git && \
    git clone https://github.com/Koishi-Star/Euler-Smea-Dyn-Sampler.git && \
    git clone https://github.com/ltdrdata/was-node-suite-comfyui.git && \
    git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && \
    git clone https://github.com/rgthree/rgthree-comfy.git && \
    git clone https://github.com/yolain/ComfyUI-Easy-Use.git && \
    git clone https://github.com/Fannovel16/ComfyUI-Frame-Interpolation.git && \
    git clone https://github.com/ashtar1984/comfyui-find-perfect-resolution.git && \
    git clone https://github.com/huchukato/ComfyUI-QwenVL-Mod.git && \
    git clone https://github.com/huchukato/ComfyUI-RIFE-TensorRT-Auto.git && \
    git clone https://github.com/huchukato/ComfyUI-Upscaler-TensorRT-Auto.git && \
    git clone https://github.com/huchukato/ComfyUI-HuggingFace.git && \
    git clone https://github.com/huchukato/comfy-tagcomplete.git && \
    git clone https://github.com/Saganaki22/ComfyUI-sol-attn.git && \
    git clone https://github.com/Comfy-Org/Nvidia_RTX_Nodes_ComfyUI.git

# ──────────────────────────────────────────────────────────────────────────────
# Install requirements (single layer, cached)
# ──────────────────────────────────────────────────────────────────────────────
RUN bash -c 'cd /opt/comfyui-baked/custom_nodes && for node_dir in */; do \
        if [ -f "$node_dir/requirements.txt" ]; then \
            echo "Installing requirements for $node_dir..." && \
            pip install --no-cache-dir -r "$node_dir/requirements.txt" || echo "Failed to install requirements for $node_dir"; \
        fi; \
    done' && \
    pip install --no-cache-dir -U "huggingface_hub" "hf-transfer" && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# llama-cpp-python (CUDA 13 wheel for QwenVL GGUF support)
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --upgrade --force-reinstall --no-cache-dir \
    https://github.com/JamePeng/llama-cpp-python/releases/download/v0.3.45-cu131-linux-20260801/llama_cpp_python-0.3.45+cu131-cp312-cp312-linux_x86_64.whl && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# sageattention (required by --use-sage-attention)
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir sageattention && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# TensorRT CUDA 13 wheels (only if needed by MiniMax H3 workflow; keep minimal)
# TODO: remove if not needed
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
        tensorrt-cu13==10.15.1.29 \
        tensorrt-cu13-bindings==10.15.1.29 \
        tensorrt-cu13-libs==10.15.1.29 && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# Update huchukato repos to latest (CACHEBUST — fast git pull, no re-clone)
# ──────────────────────────────────────────────────────────────────────────────
ARG CACHEBUST=1
RUN echo "CACHEBUST=$CACHEBUST" && \
    cd /opt/comfyui-baked/custom_nodes && \
    for repo in ComfyUI-QwenVL-Mod; do \
        if [ -d "$repo" ]; then \
            cd "$repo" && git pull --ff-only && cd ..; \
        fi; \
    done

# ──────────────────────────────────────────────────────────────────────────────
# Model directories (models downloaded at boot, not baked due to 50GB total)
# ──────────────────────────────────────────────────────────────────────────────
RUN mkdir -p /opt/comfyui-baked/models/vae && \
    mkdir -p /opt/comfyui-baked/models/diffusion_models && \
    mkdir -p /opt/comfyui-baked/models/text_encoders

# ──────────────────────────────────────────────────────────────────────────────
# Optional Hugging Face token (runtime env var) for gated/high-rate-limit
# downloads. Set HF_TOKEN in the RunPod template environment variables.
# ──────────────────────────────────────────────────────────────────────────────
ENV HF_TOKEN=""

# ──────────────────────────────────────────────────────────────────────────────
# MiniMax H3 workflow download script (small JSONs, downloaded at boot)
# Always fetches latest from GitHub into the active /workspace install.
# Overwrites existing files at every boot.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/download-minimax-workflows.sh << 'EOF'
#!/bin/bash
LOG="/var/log/minimax-h3-workflows.log"
BASE_DIR="/workspace/runpod-slim/ComfyUI/user/default/workflows"
MINIMAX_WF_URL="https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/minimax"
EXTRA_WF_URL="https://github.com/huchukato/ComfyUI-QwenVL-Mod/raw/main/vastai/workflows"
READY_MARKER="/workspace/runpod-slim/ComfyUI/main.py"
MINIMAX_WORKFLOWS=(
    "MiniMaxH3-I2VA-Qwen3VL.json"
    "MiniMaxH3-FL2VA-Qwen3VL.json"
    "MiniMaxH3-T2VA-Qwen3VL.json"
    "MiniMaxH3-R2VA-Qwen3VL.json"
    "MiniMaxH3-Turbo-I2VA-Qwen3VL.json"
    "MiniMaxH3-Turbo-FL2VA-Qwen3VL.json"
    "MiniMaxH3-Turbo-T2VA-Qwen3VL.json"
    "MiniMaxH3-Turbo-R2VA-Qwen3VL.json"
)
EXTRA_WORKFLOWS=(
    "PMP-LoRaStack-Upscale-Wildcards.json"
)

log() { echo "$(date): $*" | tee -a "$LOG"; }

download_list() {
    local base_url="$1"
    shift
    local wfs=("$@")
    for wf in "${wfs[@]}"; do
        dest="$BASE_DIR/$wf"
        if wget -q --tries=3 --timeout=30 "$base_url/$wf" -O "$dest"; then
            log "✅ $wf downloaded"
        else
            log "❌ $wf download failed"
        fi
    done
}

log "⏳ Waiting for /workspace ComfyUI..."
for i in $(seq 1 120); do
    [ -f "$READY_MARKER" ] && break
    sleep 5
done

if [ ! -f "$READY_MARKER" ]; then
    log "❌ ERROR: ComfyUI not ready after 600s, aborting workflow download"
    exit 1
fi

mkdir -p "$BASE_DIR"
log "🔄 Downloading latest MiniMax H3 workflows..."
download_list "$MINIMAX_WF_URL" "${MINIMAX_WORKFLOWS[@]}"

log "🔄 Downloading extra workflows..."
download_list "$EXTRA_WF_URL" "${EXTRA_WORKFLOWS[@]}"

log "🏁 Workflow downloads done"
EOF
RUN chmod +x /usr/local/bin/download-minimax-workflows.sh

# ──────────────────────────────────────────────────────────────────────────────
# Install huggingface_hub with XET support (hf-xet) for reliable downloads of
# both LFS and XET-backed Hugging Face repositories.
# ──────────────────────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir -U "huggingface_hub" "hf-transfer" && \
    pip cache purge

# ──────────────────────────────────────────────────────────────────────────────
# NO VAE/diffusion/text_encoder baked-in here — all MiniMax-H3 models are huge:
#   ~50GB total. Instead, a boot script downloads them to /workspace on first run.
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# Enable Rust-based Hugging Face downloader (hf-transfer) for model downloads
# This is much faster than aria2/wget single-connection on HF-hosted files.
# ──────────────────────────────────────────────────────────────────────────────
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# ──────────────────────────────────────────────────────────────────────────────
# MiniMax H3 model download script (~50GB, downloaded at boot in background)
# Waits for /workspace/runpod-slim/ComfyUI to exist, then downloads if missing.
# Robust: retries with backoff, resumes interrupted downloads, verifies size.
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/download-minimax-h3-models.sh << 'EOF'
#!/bin/bash
BASE_DIR="/workspace/runpod-slim/ComfyUI/models"
LOG="/var/log/minimax-h3-models.log"
READY_MARKER="/workspace/runpod-slim/ComfyUI/main.py"   # created by start.sh copy

# Ensure hf-transfer is available (Rust accelerator for HF downloads)
pip install --no-cache-dir -q "hf-transfer" "huggingface_hub" 2>/dev/null
export HF_HUB_ENABLE_HF_TRANSFER=1
export HF_XET_HIGH_PERFORMANCE=1

# Models: subdir|name|url|min_size_bytes (min_size = sanity check)
MODELS=(
    "vae|minimax_h3_video_vae_fp16.safetensors|https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_video_vae_fp16.safetensors|5200000000"
    "vae|minimax_h3_audio_vae_fp32.safetensors|https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/vae/minimax_h3_audio_vae_fp32.safetensors|600000000"
    "diffusion_models|minimax_h3_fl2va_pruned_int8_convrot.safetensors|https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors|20970379616"
    "diffusion_models|minimax_h3_ref2va_pruned_int8_convrot.safetensors|https://huggingface.co/Comfy-Org/MiniMax-H3/resolve/main/diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors|20970379616"
    "text_encoders|qwen3vl_32b_h3_ultra_uncensored_heretic_int8_convrot.safetensors|https://huggingface.co/ethanfel/Qwen3-VL-32B-Ultra-Heretic-H3-ComfyUI-INT8-ConvRot/resolve/main/qwen3vl_32b_h3_ultra_uncensored_heretic_int8_convrot.safetensors|26000000000"
    "loras|minimax_h3_turbo_v4_step600_ema.safetensors|https://huggingface.co/larryvrh/MiniMax-H3-Turbo-Lora/resolve/main/minimax_h3_turbo_v4_step600_ema.safetensors|779849816"
    # 10Eros-Max INT8 ConvRot HQ (~22GB) — only 32 QKV tensors modified, rest bit-identical to H3
    # Better prompt adherence + audio than beta1, same VRAM as standard H3 int8
    "diffusion_models|10Eros_Max_H3_FL2VA-INT8-ConvRot-HQ.safetensors|https://huggingface.co/DmitryDB/MiniMax-H3-10Eros-Max-Quants/resolve/main/FL2VA/10Eros_Max_H3_FL2VA-INT8-ConvRot-HQ.safetensors|22000000000"
    # Turbo LoRA 8-step for 10Eros-Max pruned (1.96GB) — compat full-width
    "loras|minimax_h3_fl2v_turbo_8step_v1.0_10ErosMax_beta1_pruned_compat_v001_T8.safetensors|https://huggingface.co/t8star/minimax_h3_turbo_4step_10ErosMax_test4_pruned_curveproj1025_T8/resolve/main/minimax_h3_fl2v_turbo_8step_v1.0_10ErosMax_beta1_pruned_compat_v001_T8.safetensors|1950000000"
)

log() { echo "$(date): $*" | tee -a "$LOG"; }

log "📥 === MiniMax H3 model download started (PID $$) ==="
log "⏳ Waiting for /workspace mount and ComfyUI ready marker..."
for i in $(seq 1 120); do
    [ -f "$READY_MARKER" ] && break
    sleep 5
done

if [ ! -f "$READY_MARKER" ]; then
    log "❌ ERROR: ComfyUI ready marker not found after 600s, aborting"
    exit 1
fi

log "✅ ComfyUI ready, base dir: $BASE_DIR"
mkdir -p "$BASE_DIR"/{vae,diffusion_models,text_encoders,loras}

download_model() {
    local subdir="$1" name="$2" url="$3" min_size="$4"
    local dest="$BASE_DIR/$subdir/$name"
    local max_retries=5

    # Parse repo_id and relative repo path from the Hugging Face URL.
    local repo_id repo_path
    repo_id=$(echo "$url" | awk -F/ '{print $4"/"$5}')
    repo_path=$(echo "$url" | sed -E 's#https?://[^/]+/[^/]+/[^/]+/resolve/main/(.+)#\1#')

    # Use 'hf' command (newer huggingface_hub) or fall back to 'huggingface-cli'
    local hf_cmd="hf"
    command -v hf >/dev/null 2>&1 || hf_cmd="huggingface-cli"

    for attempt in $(seq 1 $max_retries); do
        if [ -f "$dest" ] || [ -L "$dest" ]; then
            local size
            size=$(stat -L -c%s "$dest" 2>/dev/null || stat -L -f%z "$dest" 2>/dev/null || echo 0)
            if [ "$size" -ge "$min_size" ]; then
                log "✅ $name already present ($size bytes >= $min_size), skipping"
                return 0
            else
                log "⚠️  $name incomplete ($size bytes < $min_size), retrying (attempt $attempt/$max_retries)"
            fi
        else
            log "📥 Downloading $name (attempt $attempt/$max_retries)..."
        fi

        # Download to a temp dir to avoid path nesting issues.
        local tmp_dir="$BASE_DIR/.tmp_download_${name//\//_}"
        rm -rf "$tmp_dir"
        mkdir -p "$tmp_dir" "$(dirname "$dest")"
        export HF_HUB_ENABLE_HF_TRANSFER=1
        export HF_XET_HIGH_PERFORMANCE=1
        # hf: resume is automatic; huggingface-cli: needs --resume-download
        local resume_flag=""
        [ "$hf_cmd" = "huggingface-cli" ] && resume_flag="--resume-download"
        # Timeout: 15 min per file, prevents infinite stalls
        if timeout 900 $hf_cmd download "$repo_id" "$repo_path" \
                --local-dir "$tmp_dir" \
                $resume_flag 2>&1 | tee -a "$LOG"; then
            local downloaded_path="$tmp_dir/$repo_path"
            if [ -f "$downloaded_path" ] || [ -L "$downloaded_path" ]; then
                if [ -L "$downloaded_path" ]; then
                    ln -sf "$(readlink -f "$downloaded_path")" "$dest"
                else
                    mv -f "$downloaded_path" "$dest"
                fi
                rm -rf "$tmp_dir"
                local size
                size=$(stat -L -c%s "$dest" 2>/dev/null || stat -L -f%z "$dest" 2>/dev/null || echo 0)
                if [ "$size" -ge "$min_size" ]; then
                    log "✅ $name downloaded successfully ($size bytes)"
                    return 0
                else
                    log "⚠️  $name downloaded but size $size < $min_size, will retry"
                fi
            else
                log "⚠️  $name not found at $downloaded_path after download, will retry"
                rm -rf "$tmp_dir"
            fi
        else
            log "⚠️  $hf_cmd failed for $name (attempt $attempt), retrying in $((attempt*10))s..."
            rm -rf "$tmp_dir"
        fi

        [ "$attempt" -lt "$max_retries" ] && sleep $((attempt * 30))
    done

    log "❌ FAILED: $name could not be downloaded after $max_retries attempts"
    return 1
}

failures=0
for entry in "${MODELS[@]}"; do
    IFS='|' read -r subdir name url min_size <<< "$entry"
    download_model "$subdir" "$name" "$url" "$min_size" || failures=$((failures + 1))
    # Small delay between downloads to avoid HF rate limiting (429)
    sleep 5
done

log "📦 === MiniMax H3 model download finished ($failures failures) ==="
EOF
RUN chmod +x /usr/local/bin/download-minimax-h3-models.sh

# ──────────────────────────────────────────────────────────────────────────────
# Custom entrypoint: force ComfyUI v0.32.0, pre-populate args,
# launch MiniMax H3 model download in background, then exec /start.sh
# ──────────────────────────────────────────────────────────────────────────────
RUN cat > /usr/local/bin/custom-entrypoint.sh << 'EOF'
#!/bin/bash
COMFY_LOG="/var/log/comfyui-update.log"
COMFY_TAG="v0.32.0"

force_comfyui_version() {
    local repo_dir="$1"
    local label="$2"
    if [ ! -d "$repo_dir/.git" ]; then
        echo "$(date): ⚠️  $label no .git, skipping" | tee -a "$COMFY_LOG"
        return 0
    fi

    local current_tag
    current_tag=$(git -C "$repo_dir" describe --tags --exact-match HEAD 2>/dev/null || echo "")
    if [ "$current_tag" = "$COMFY_TAG" ]; then
        echo "$(date): ✅ $label already on $COMFY_TAG" | tee -a "$COMFY_LOG"
        return 0
    fi

    echo "$(date): 🔧 Ensuring $label is on $COMFY_TAG (current: ${current_tag:-unknown})..." | tee -a "$COMFY_LOG"
    git -C "$repo_dir" reset --hard 2>>"$COMFY_LOG" || true
    git -C "$repo_dir" clean -fd 2>>"$COMFY_LOG" || true

    if timeout 60 git -C "$repo_dir" fetch --tags origin 2>>"$COMFY_LOG"; then
        local current_hash target_hash
        current_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        if timeout 30 git -C "$repo_dir" -c advice.detachedHead=false checkout -f "$COMFY_TAG" 2>>"$COMFY_LOG"; then
            target_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            echo "$(date): ✅ $label forced to $COMFY_TAG ($current_hash -> $target_hash)" | tee -a "$COMFY_LOG"
            if [ -f "$repo_dir/requirements.txt" ]; then
                echo "$(date): 🔄 Re-installing $label requirements..." | tee -a "$COMFY_LOG"
                pip install --no-cache-dir -r "$repo_dir/requirements.txt" 2>>"$COMFY_LOG" | tail -n 10 | tee -a "$COMFY_LOG" || true
            fi
        else
            echo "$(date): ❌ $label checkout $COMFY_TAG failed" | tee -a "$COMFY_LOG"
        fi
    else
        echo "$(date): ⚠️  $label fetch tags failed/timed out (offline?), leaving at current version" | tee -a "$COMFY_LOG"
    fi
}

update_custom_nodes() {
    local nodes_dir="$1"
    [ ! -d "$nodes_dir" ] && return 0
    echo "$(date): 🔄 Updating custom nodes in $nodes_dir..." | tee -a "$COMFY_LOG"
    for node_dir in "$nodes_dir"/*; do
        [ ! -d "$node_dir/.git" ] && continue
        local name branch
        name=$(basename "$node_dir")
        branch=$(git -C "$node_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
        echo "$(date): ⏳ Updating $name (branch $branch)..." | tee -a "$COMFY_LOG"
        # Try fast-forward first; if the repo is divergent/dirty, hard-reset to remote.
        if timeout 60 git -C "$node_dir" pull --ff-only origin "$branch" 2>>"$COMFY_LOG"; then
            echo "$(date): ✅ $name updated" | tee -a "$COMFY_LOG"
        else
            echo "$(date): ⚠️  $name pull failed, attempting hard reset to origin/$branch" | tee -a "$COMFY_LOG"
            if timeout 60 git -C "$node_dir" fetch origin "$branch" 2>>"$COMFY_LOG" && \
               timeout 30 git -C "$node_dir" reset --hard "origin/$branch" 2>>"$COMFY_LOG"; then
                echo "$(date): ✅ $name reset to origin/$branch" | tee -a "$COMFY_LOG"
            else
                echo "$(date): ⚠️  $name update failed, leaving as-is" | tee -a "$COMFY_LOG"
            fi
        fi
        if [ -f "$node_dir/requirements.txt" ]; then
            echo "$(date): 🔄 Installing requirements for $name..." | tee -a "$COMFY_LOG"
            pip install --no-cache-dir -r "$node_dir/requirements.txt" 2>>"$COMFY_LOG" | tail -n 5 | tee -a "$COMFY_LOG" || true
        fi
    done
}

# Force baked ComfyUI core to v0.32.0
force_comfyui_version /opt/comfyui-baked "ComfyUI (baked template)"

# Force active install on /workspace if it already exists (affects restarts)
if [ -d /workspace/runpod-slim/ComfyUI/.git ]; then
    force_comfyui_version /workspace/runpod-slim/ComfyUI "ComfyUI (active install)"
    # Also update custom nodes in the active install
    update_custom_nodes /workspace/runpod-slim/ComfyUI/custom_nodes
fi

# Pre-populate comfyui_args.txt with MiniMax H3 / QwenVL-Mod args if it doesn't exist
ARGS_FILE="/workspace/runpod-slim/comfyui_args.txt"
if [ ! -f "$ARGS_FILE" ]; then
    mkdir -p /workspace/runpod-slim
    cat > "$ARGS_FILE" << 'INNER'
# Custom ComfyUI arguments (one per line, # = comment)
--disable-auto-launch --fast fp16_accumulation --use-sage-attention --cuda-malloc --async-offload
INNER
    echo "Created comfyui_args.txt with MiniMax H3 / QwenVL-Mod optimized args"
fi

# Launch MiniMax H3 workflow download in background (always fetches latest from GitHub)
setsid /usr/local/bin/download-minimax-workflows.sh </dev/null &

# Launch MiniMax H3 model download in a detached session (survives exec /start.sh)
# ~50GB, takes a long time on first boot; models persist on /workspace volume.
setsid /usr/local/bin/download-minimax-h3-models.sh </dev/null &

# Execute original start.sh from template base — ComfyUI starts immediately.
exec /start.sh
EOF
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

# ──────────────────────────────────────────────────────────────────────────────
# Clean up heavy Git files to save space
# ──────────────────────────────────────────────────────────────────────────────
RUN find /opt/comfyui-baked/custom_nodes -name ".git" -type d -exec find {} -name "*.pack" -delete + 2>/dev/null || true && \
    find /opt/comfyui-baked/custom_nodes -name ".git" -type d -exec find {} -name "pack-*.idx" -delete + 2>/dev/null || true && \
    find /opt/comfyui-baked/custom_nodes -name ".git" -type d -exec find {} -name "objects" -type d -exec rm -rf {} + 2>/dev/null || true

# Override entrypoint
ENTRYPOINT ["/usr/local/bin/custom-entrypoint.sh"]
